# Configuración de Conexión a Neon PostgreSQL
# Copia tu cadena de conexión desde Neon Console (https://console.neon.tech)
# IMPORTANTE: Para peticiones en navegador con @neondatabase/serverless, la URI debe ser https:// o postgres://
VITE_NEON_DATABASE_URL="postgres://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Configuración opcional para notificaciones de correo mediante Web3Forms (gratuito)
# Obtén tu clave en https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY="tu-access-key-de-web3forms"
VITE_ADMIN_NOTIFICATION_EMAIL="admin@tuempresa.com"

# Contraseña por defecto para el Panel de Administración (cambiar en producción)
VITE_ADMIN_PASSWORD="admin123"
